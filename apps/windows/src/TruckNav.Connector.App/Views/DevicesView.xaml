<UserControl x:Class="TruckNav.Connector.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:DeviceEntryViewModel}" xmlns:vm="clr-namespace:TruckNav.Connector.App.ViewModels">
            <Border Margin="0,0,0,10"
                    Style="{StaticResource TruckNavCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="38"
                            Height="38"
                            Background="{StaticResource Surface3Brush}"
                            CornerRadius="10">
                        <TextBlock Text="&#xE8EA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource MonoValueTextStyle}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding Subtitle}"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            Padding="10,5"
                            VerticalAlignment="Center"
                            Background="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}"
                            BorderThickness="1"
                            CornerRadius="99">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}}" />
                            <TextBlock Margin="6,0,0,0"
                                       Text="{Binding StatusText}"
                                       Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}}" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="{Binding ActionText}"
                            Command="{Binding ActionCommand}"
                            IsEnabled="{Binding IsActionEnabled}"
                            Style="{StaticResource TruckNavCardActionButtonStyle}"
                            Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Devices" Style="{StaticResource PageHeadingTextStyle}" />

            <TextBlock Margin="0,18,0,8"
                       Text="CONNECTED DEVICES"
                       Style="{StaticResource SectionLabelTextStyle}" />
            <ItemsControl ItemsSource="{Binding ConnectedDevices}"
                          Visibility="{Binding HasConnectedDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Style="{StaticResource TruckNavCardStyle}"
                    Visibility="{Binding HasConnectedDevices, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="No phone is paired with this PC yet."
                           Style="{StaticResource BodyTextStyle}" />
            </Border>

            <TextBlock Margin="0,18,0,8"
                       Text="NEARBY DEVICES"
                       Style="{StaticResource SectionLabelTextStyle}" />
            <ItemsControl ItemsSource="{Binding NearbyDevices}"
                          Visibility="{Binding HasNearbyDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Style="{StaticResource TruckNavCardStyle}"
                    Visibility="{Binding HasNearbyDevices, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="Open TruckNav on your phone and it will appear here automatically."
                           Style="{StaticResource BodyTextStyle}" />
            </Border>

            <TextBlock Margin="0,18,0,8"
                       Text="PREVIOUS DEVICES"
                       Style="{StaticResource SectionLabelTextStyle}" />
            <ItemsControl ItemsSource="{Binding PreviousDevices}"
                          Visibility="{Binding HasPreviousDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Border Style="{StaticResource TruckNavCardStyle}"
                    Visibility="{Binding HasPreviousDevices, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="No previous devices yet."
                           Style="{StaticResource BodyTextStyle}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
