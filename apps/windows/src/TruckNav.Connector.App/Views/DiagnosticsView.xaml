<UserControl x:Class="TruckNav.Connector.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Button Content="Settings"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource TruckNavGhostButtonStyle}" />
            <TextBlock Margin="0,12,0,0"
                       Text="Advanced / Diagnostics"
                       Style="{StaticResource PageHeadingTextStyle}" />
            <TextBlock Margin="0,4,0,0"
                       Text="Native telemetry, graph, routing, and LAN protocol details."
                       Style="{StaticResource BodyTextStyle}" />

            <ItemsControl Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <primitives:UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <Border Margin="0,0,12,12" Style="{StaticResource TruckNavCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Connection" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding ConnectionDetails}"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,12" Style="{StaticResource TruckNavCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Native Navigation" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding NavigationDetails}"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <Border Margin="0,0,0,12" Style="{StaticResource TruckNavCardStyle}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Game Setup" Style="{StaticResource CardTitleTextStyle}" />
                        <Button HorizontalAlignment="Right" Content="Refresh" Command="{Binding RefreshSetupCommand}" Style="{StaticResource TruckNavButtonStyle}" />
                    </Grid>
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding SetupDetails}"
                               FontFamily="Consolas"
                               FontSize="11.5"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource TruckNavCardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent Activity" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding RecentActivity}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
