<UserControl x:Class="TruckNav.Connector.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="TruckNav Connector" Style="{StaticResource PageHeadingTextStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
            <Ellipse Width="6"
                     Height="6"
                     VerticalAlignment="Center"
                     Fill="{Binding DataContext.ReadyState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StatusToneToBrushConverter}}" />
            <TextBlock Margin="8,0,0,0"
                       Text="{Binding DataContext.ConnectorName, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource MonoValueTextStyle}"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Margin="6,1,0,0"
                       Text="{Binding DataContext.ReadySummary, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource CaptionTextStyle}" />
        </StackPanel>

        <ItemsControl Grid.Row="2" Margin="0,18,0,0" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <primitives:UniformGrid Columns="2" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,12,12"
                            Style="{StaticResource TruckNavCardStyle}"
                            BorderBrush="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding IconGlyph}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           Text="{Binding Title}"
                                           Style="{StaticResource CardTitleTextStyle}" />
                            </StackPanel>

                            <TextBlock Margin="0,14,0,0" Text="{Binding PrimaryText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardValueTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseMonospacePrimary}" Value="True">
                                                <Setter Property="FontFamily" Value="Consolas" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UseToneForPrimary}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding SecondaryText}"
                                       Style="{StaticResource CaptionTextStyle}" />

                            <Border Margin="0,12,0,0"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Background="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}"
                                    BorderBrush="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}"
                                    BorderThickness="1"
                                    CornerRadius="99"
                                    Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6"
                                             Height="6"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}}" />
                                    <TextBlock Margin="6,0,0,0"
                                               Text="{Binding StatusText}"
                                               Style="{StaticResource MonoCaptionTextStyle}"
                                               Foreground="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}}" />
                                </StackPanel>
                            </Border>

                            <Button Margin="0,12,0,0"
                                    Content="{Binding ActionText}"
                                    Command="{Binding ActionCommand}"
                                    IsEnabled="{Binding IsActionEnabled}"
                                    Style="{StaticResource TruckNavCardActionButtonStyle}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
