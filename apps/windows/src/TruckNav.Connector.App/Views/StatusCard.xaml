<UserControl x:Class="TruckNav.Connector.App.Views.StatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="370"
            Margin="0,0,16,16"
            Background="{StaticResource Surface2Brush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="22">
        <Grid>
            <Rectangle Width="6"
                       HorizontalAlignment="Left"
                       Fill="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}}"
                       RadiusX="22"
                       RadiusY="22" />
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource CardTitleTextStyle}" />
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding State}"
                           Style="{StaticResource PageTitleTextStyle}"
                           FontSize="22" />
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding Detail}"
                           Style="{StaticResource SecondaryBodyTextStyle}"
                           TextWrapping="Wrap" />
                <Border Margin="0,18,0,0"
                        Padding="12"
                        Background="{Binding Tone, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}"
                        CornerRadius="16">
                    <TextBlock Text="{Binding Hint}"
                               Style="{StaticResource SecondaryBodyTextStyle}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource PrimaryTextBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
