<UserControl x:Class="TruckNav.Connector.App.Views.FirstTimeSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid Visibility="{Binding IsNameStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="320"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock Text="&#xE768;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           Text="Welcome to TruckNav Connector"
                           Style="{StaticResource PageHeadingTextStyle}" />
                <TextBlock Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           Text="Turn your Android phone or tablet into a wireless ETS2/ATS GPS."
                           Style="{StaticResource BodyTextStyle}"
                           TextAlignment="Center" />

                <TextBlock Margin="0,28,0,0"
                           Text="Name this PC"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBox Margin="0,8,0,0"
                         Text="{Binding ConnectorName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TruckNavTextBoxStyle}" />
                <TextBlock Margin="0,8,0,0"
                           Text="This name will be visible to TruckNav devices on your local network."
                           Style="{StaticResource CaptionTextStyle}" />

                <Button Margin="0,26,0,0"
                        Width="144"
                        HorizontalAlignment="Center"
                        Content="Continue"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource TruckNavPrimaryButtonStyle}" />

                <StackPanel Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource FaintTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Margin="6,0,0,0"
                               Text="LOCAL NETWORK ONLY"
                               Style="{StaticResource MonoCaptionTextStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding IsPermissionStep, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Width="320"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="60"
                        Height="60"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           Text="Allow local connections"
                           Style="{StaticResource PageHeadingTextStyle}"
                           FontSize="18" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Text="TruckNav Connector needs access to your local network so your phone or tablet can find this PC."
                           Style="{StaticResource BodyTextStyle}"
                           TextAlignment="Center" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Text="TruckNav does not require an internet connection."
                           Style="{StaticResource CaptionTextStyle}"
                           TextAlignment="Center" />

                <Button Margin="0,26,0,0"
                        Width="144"
                        HorizontalAlignment="Center"
                        Content="Continue"
                        Command="{Binding ContinueCommand}"
                        Style="{StaticResource TruckNavPrimaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
