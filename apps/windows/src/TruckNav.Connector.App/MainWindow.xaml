<Window x:Class="TruckNav.Connector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:TruckNav.Connector.App.ViewModels"
        mc:Ignorable="d"
        Title="TruckNav Connector"
        Width="1480"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        Background="{StaticResource BackgroundBrush}">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="24"
                Padding="24"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="26">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="TRUCKNAV"
                               Style="{StaticResource OverlineTextStyle}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="{Binding ConnectorName}"
                               Style="{StaticResource DisplayTitleTextStyle}" />
                    <TextBlock Margin="0,10,0,0"
                               Text="Connector shell for the Windows tray app, game capture flow, and local network session manager."
                               Style="{StaticResource SecondaryBodyTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,26,0,0"
                        Padding="12,8"
                        HorizontalAlignment="Left"
                        Background="{Binding ReadyState, Converter={StaticResource StatusToneToBrushConverter}, ConverterParameter=Background}"
                        CornerRadius="999">
                    <TextBlock Text="{Binding ReadySummary}"
                               Style="{StaticResource PillTextStyle}" />
                </Border>

                <ListBox Grid.Row="2"
                         Margin="0,28,0,24"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:NavigationItemViewModel}">
                            <Border Margin="0,0,0,10"
                                    Padding="16"
                                    Background="{Binding IsSelected, Converter={StaticResource BooleanToSelectionBrushConverter}}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource CardTitleTextStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Description}"
                                               Style="{StaticResource SecondaryBodyTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3"
                        Padding="18"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <StackPanel>
                        <TextBlock Text="Phase 1 Status"
                                   Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding FooterSummary}"
                                   Style="{StaticResource SecondaryBodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,24,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.Title}"
                                   Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding CurrentPage.Description}"
                                   Style="{StaticResource SecondaryBodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="14,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="Approved HTML design files missing"
                                       Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="This shell is tokenized and state-driven, ready for the missing design references to be applied without reworking app structure."
                                       Style="{StaticResource SecondaryBodyTextStyle}"
                                       TextWrapping="Wrap"
                                       Width="320" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,20,0,0"
                    Padding="28"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="26">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
