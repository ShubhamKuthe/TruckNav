<Window x:Class="TruckNav.Connector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TruckNav Connector"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid Background="{StaticResource BackgroundBrush}">
        <ContentControl Content="{Binding CurrentPage}"
                        Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Visibility="{Binding IsShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="8,14,8,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TruckNavSidebarItemStyle}"
                                        Command="{Binding DataContext.NavigateToPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding PageId}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="1" Margin="10,0,10,4">
                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource MonoCaptionTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{Binding ReadyState, Converter={StaticResource StatusToneToBrushConverter}}"
                                     VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0"
                                       Text="{Binding ReadySummary}"
                                       Style="{StaticResource MonoCaptionTextStyle}"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="24,22,24,22">
                <ContentControl Content="{Binding CurrentPage}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
